# --- Required ---------------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses to start if this is short or the placeholder.
JWT_SECRET=change-this-to-a-long-random-string

# Where the website runs (comma-separate several). Only these origins may call the API.
CLIENT_ORIGIN=http://localhost:5173

# --- Optional ---------------------------------------------------------------
PORT=4000
# NODE_ENV=production
# Put the database and uploads on a persistent disk when deploying:
# DB_PATH=/var/data/facultyconnect.sqlite3
# UPLOADS_DIR=/var/data/uploads
# Set to 1 when the API sits behind one proxy/load balancer (Render, Railway, ...)
# so rate limiting sees each visitor's real address.
# TRUST_PROXY=1
